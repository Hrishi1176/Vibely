# PostgreSQL Database URL Example:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vibely_db
# Or Supabase PostgreSQL Free Tier (Connection Pooler):
# DATABASE_URL=postgresql://postgres.jaxngdaukvxgquwbpdvj:Hrishi%401176@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

DATABASE_URL=sqlite:///./vibely.db

# Groq Cloud Free AI Key (from https://console.groq.com)
GROQ_API_KEY=

# Default welcome text and app greeting
DEFAULT_BIO=Welcome to Vibely! Share your world, connect your vibe ✨
DEFAULT_WELCOME_POST=🎉 Welcome to Vibely! An AI-powered, 100% free social network designed for creators. Generate smart post captions, chat with VibeAI, and connect with your tribe!
AI_FALLBACK_TEMPLATE=VibeAI Assistant: Thanks for your message! '{message}' sounds super interesting. Add GROQ_API_KEY to your environment or .env file to unlock full live Llama 3 responses!

# Security
SECRET_KEY=vibely_super_secret_jwt_key_2026
GOOGLE_CLIENT_ID=

